{
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://libraryhub_mcp:mcp_readonly_pass@localhost:5432/library_hub"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx --prefix C:/Users/ajay.bohra/library-hub/backend prettier --write \"${file}\" 2>nul || exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const f=process.env.CLAUDE_TOOL_INPUT_FILE_PATH||process.env.file||''; if(f.includes('.env')&&!f.includes('.env.example')){process.stderr.write('BLOCKED: Never edit .env files\\n');process.exit(2);}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdout.write('Task complete at ' + new Date().toLocaleTimeString() + '\\n')\""
          }
        ]
      }
    ]
  }
}
